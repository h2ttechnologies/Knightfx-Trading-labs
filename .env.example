# Public origin used by canonical sitemap and robots metadata.
NEXT_PUBLIC_SITE_URL=https://knightfxtradinglabs.vercel.app

# Supabase project URL and public anon key can be used by the browser admin console.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key. Never use the service role key in NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
